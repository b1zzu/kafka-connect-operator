{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update default Apache Kafka image in Go source files",
      "managerFilePatterns": [
        "/\\.go$/"
      ],
      "matchStrings": [
        "\"(?<depName>docker\\.io\\/apache\\/kafka):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update kafka-connect-library images in Go source files",
      "managerFilePatterns": [
        "/\\.go$/"
      ],
      "matchStrings": [
        "\"(?<depName>ghcr\\.io\\/b1zzu\\/kafka-connect-library\\/[^:\"]+):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update kafka-connect-library images in YAML and Markdown files",
      "managerFilePatterns": [
        "/^config\\/(samples|e2e)\\/.+\\.yaml$/",
        "/^README\\.md$/",
        "/^docs\\/.+\\.md$/"
      ],
      "matchStrings": [
        "image: (?<depName>ghcr\\.io\\/b1zzu\\/kafka-connect-library\\/[^:\\s]+):(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Group all Go module dependency updates",
      "matchManagers": [
        "gomod"
      ],
      "groupName": "go dependencies"
    },
    {
      "description": "Group all main Dockerfile updates",
      "matchFileNames": [
        "Dockerfile"
      ],
      "groupName": "dockerfile"
    }
  ]
}
