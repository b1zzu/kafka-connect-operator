{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update default Apache Kafka image in Go source files",
      "fileMatch": ["\\.go$"],
      "matchStrings": [
        "\"(?<depName>docker\\.io\\/apache\\/kafka):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update connect-file plugin version in plugins Dockerfile",
      "fileMatch": ["^plugins/Dockerfile$"],
      "matchStrings": [
        "ARG CONNECT_FILE_VERSION=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "org.apache.kafka:connect-file",
      "datasourceTemplate": "maven",
      "registryUrlTemplate": "https://repo1.maven.org/maven2"
    },
    {
      "customType": "regex",
      "description": "Update connect-mirror plugin version in plugins Dockerfile",
      "fileMatch": ["^plugins/Dockerfile$"],
      "matchStrings": [
        "ARG CONNECT_MIRROR_VERSION=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "org.apache.kafka:connect-mirror",
      "datasourceTemplate": "maven",
      "registryUrlTemplate": "https://repo1.maven.org/maven2"
    },
    {
      "customType": "regex",
      "description": "Update JMX Exporter version in jmx-exporter Dockerfile",
      "fileMatch": ["^jmx-exporter/Dockerfile$"],
      "matchStrings": [
        "ARG JMX_EXPORTER_VERSION=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "prometheus/jmx_exporter",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update default JMX Exporter image in Go source files",
      "fileMatch": ["\\.go$"],
      "matchStrings": [
        "\"(?<depName>ghcr\\.io\\/b1zzu\\/kafka-connect-operator\\/jmx-exporter):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Group all Go module dependency updates",
      "matchManagers": ["gomod"],
      "groupName": "go dependencies"
    },
    {
      "description": "Group all main Dockerfile updates",
      "matchFileNames": ["Dockerfile"],
      "groupName": "dockerfile"
    },
    {
      "description": "Group all plugins Dockerfile updates",
      "matchFileNames": ["plugins/Dockerfile"],
      "groupName": "plugins dockerfile"
    },
    {
      "description": "Group all jmx-exporter Dockerfile updates",
      "matchFileNames": ["jmx-exporter/Dockerfile"],
      "groupName": "jmx-exporter dockerfile"
    }
  ]
}
