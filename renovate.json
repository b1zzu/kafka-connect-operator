{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update default Apache Kafka image in Go source files",
      "managerFilePatterns": [
        "/\\.go$/"
      ],
      "matchStrings": [
        "\"(?<depName>docker\\.io\\/apache\\/kafka):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update connect-file plugin version in sample-plugins Dockerfile",
      "managerFilePatterns": [
        "/^containers/sample-plugins/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG CONNECT_FILE_VERSION=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "org.apache.kafka:connect-file",
      "datasourceTemplate": "maven",
      "registryUrlTemplate": "https://repo1.maven.org/maven2"
    },
    {
      "customType": "regex",
      "description": "Update connect-mirror plugin version in sample-plugins Dockerfile",
      "managerFilePatterns": [
        "/^containers/sample-plugins/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG CONNECT_MIRROR_VERSION=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "org.apache.kafka:connect-mirror",
      "datasourceTemplate": "maven",
      "registryUrlTemplate": "https://repo1.maven.org/maven2"
    },
    {
      "customType": "regex",
      "description": "Update JMX Exporter version in jmx-exporter Dockerfile",
      "managerFilePatterns": [
        "/^containers/jmx-exporter/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG JMX_EXPORTER_VERSION=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "prometheus/jmx_exporter",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update default JMX Exporter image in Go source files",
      "managerFilePatterns": [
        "/\\.go$/"
      ],
      "matchStrings": [
        "\"(?<depName>ghcr\\.io\\/b1zzu\\/kafka-connect-operator\\/jmx-exporter):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update kafka-connect-datagen version in kafka-connect-datagen Dockerfile",
      "managerFilePatterns": ["/^containers/kafka-connect-datagen/Dockerfile$/"],
      "matchStrings": ["ARG CONNECT_DATAGEN_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "confluentinc/kafka-connect-datagen",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Update MSK IAM Auth version in msk-iam-auth Dockerfile",
      "managerFilePatterns": [
        "/^containers/msk-iam-auth/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG MSK_IAM_AUTH_VERSION=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "aws/aws-msk-iam-auth",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Update default MSK IAM Auth image in Go source files",
      "managerFilePatterns": [
        "/\\.go$/"
      ],
      "matchStrings": [
        "\"(?<depName>ghcr\\.io\\/b1zzu\\/kafka-connect-operator\\/msk-iam-auth):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update Debezium PostgreSQL version in debezium-postgres Dockerfile",
      "managerFilePatterns": [
        "/^containers/debezium-postgres/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG DEBEZIUM_VERSION=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "io.debezium:debezium-connector-postgres",
      "datasourceTemplate": "maven",
      "registryUrlTemplate": "https://repo1.maven.org/maven2"
    },
    {
      "customType": "regex",
      "description": "Update AWS Advanced JDBC Wrapper version in debezium-postgres Dockerfile",
      "managerFilePatterns": [
        "/^containers/debezium-postgres/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG AWS_JDBC_WRAPPER_VERSION=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "software.amazon.jdbc:aws-advanced-jdbc-wrapper",
      "datasourceTemplate": "maven",
      "registryUrlTemplate": "https://repo1.maven.org/maven2"
    },
    {
      "customType": "regex",
      "description": "Update Log4j Layout Template JSON version in Dockerfile",
      "managerFilePatterns": [
        "/^containers/log4j-layout-template-json/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG LOG4J_VERSION=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "org.apache.logging.log4j:log4j-layout-template-json",
      "datasourceTemplate": "maven",
      "registryUrlTemplate": "https://repo1.maven.org/maven2"
    },
    {
      "customType": "regex",
      "description": "Update default Log4j Layout Template JSON image in Go source files",
      "managerFilePatterns": [
        "/\\.go$/"
      ],
      "matchStrings": [
        "\"(?<depName>ghcr\\.io\\/b1zzu\\/kafka-connect-operator\\/log4j-layout-template-json):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Group all Go module dependency updates",
      "matchManagers": [
        "gomod"
      ],
      "groupName": "go dependencies"
    },
    {
      "description": "Group all main Dockerfile updates",
      "matchFileNames": [
        "Dockerfile"
      ],
      "groupName": "dockerfile"
    },
    {
      "description": "Group all sample-plugins Dockerfile updates",
      "matchFileNames": [
        "containers/sample-plugins/Dockerfile"
      ],
      "groupName": "sample-plugins dockerfile"
    },
    {
      "description": "Group all jmx-exporter Dockerfile updates",
      "matchFileNames": [
        "containers/jmx-exporter/Dockerfile"
      ],
      "groupName": "jmx-exporter dockerfile"
    },
    {
      "description": "Group all kafka-connect-datagen Dockerfile updates",
      "matchFileNames": [
        "containers/kafka-connect-datagen/Dockerfile"
      ],
      "groupName": "kafka-connect-datagen dockerfile"
    },
    {
      "description": "Group all msk-iam-auth Dockerfile updates",
      "matchFileNames": [
        "containers/msk-iam-auth/Dockerfile"
      ],
      "groupName": "msk-iam-auth dockerfile"
    },
    {
      "description": "Group all log4j-layout-template-json Dockerfile updates",
      "matchFileNames": [
        "containers/log4j-layout-template-json/Dockerfile"
      ],
      "groupName": "log4j-layout-template-json dockerfile"
    },
    {
      "description": "Group all debezium-postgres Dockerfile updates",
      "matchFileNames": [
        "containers/debezium-postgres/Dockerfile"
      ],
      "groupName": "debezium-postgres dockerfile"
    }
  ]
}
